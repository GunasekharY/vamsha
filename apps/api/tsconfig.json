{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "paths": {
      "@vamsha/shared-types": ["../../packages/shared-types/src"],
      "@vamsha/graph-engine": ["../../packages/graph-engine/src"]
    }
  },
  "include": ["src"]
}
