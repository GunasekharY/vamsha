{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@vamsha/shared-types": ["../../packages/shared-types/src"],
      "@vamsha/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["src"]
}
